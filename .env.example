# Copy to .env (never commit .env).
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=choose-a-password
POSTGRES_DB=mlflow
MLFLOW_PORT=5050                 # MLflow UI at http://localhost:5050
FREIGHT_DATA_DIR=./data          # folder holding the four CSVs; mounted read-only
# EXTRA_CA_CERT=/path/to/ca.pem  # only behind a TLS-intercepting proxy (used while building images)
