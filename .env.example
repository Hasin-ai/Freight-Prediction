# Copy to .env (never commit .env).
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=choose-a-password
POSTGRES_DB=mlflow
# MLflow UI at http://localhost:<MLFLOW_PORT>
MLFLOW_PORT=5050
# Folder holding the four CSVs; mounted read-only into the containers
FREIGHT_DATA_DIR=./data
# Only behind a TLS-intercepting proxy: CA certificate used while building images
# EXTRA_CA_CERT=/path/to/ca.pem
